---
interface Props {
  slug: string;
  title: string;
  outcome: string;
  summary: string;
  stack: string[];
  company?: string;
  year?: string;
  repo?: string;
  index: number;
}

const { slug, title, outcome, summary, stack, company, year, repo, index } =
  Astro.props;
const idx = String(index).padStart(2, "0");
---

<a
  href={`/case-studies/${slug}`}
  class="group block rounded-xl border border-ink-800 bg-ink-900/40 p-8 transition hover:border-ink-600 hover:bg-ink-900"
>
  <div class="flex items-start justify-between gap-6">
    <div class="space-y-5">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="font-mono text-xs text-ink-500">{idx}</span>
        {
          (company || year) && (
            <span class="font-mono text-xs text-ink-400">
              {[company, year].filter(Boolean).join(" · ")}
            </span>
          )
        }
        {
          repo && (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 font-mono text-[0.7rem] text-accent">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
              </svg>
              Open source
            </span>
          )
        }
      </div>

      <h3
        class="text-2xl text-ink-50 transition-colors group-hover:text-accent md:text-3xl"
      >
        {title}
      </h3>

      <p class="text-ink-300">
        <span class="text-ink-200">{outcome}</span> — {summary}
      </p>

      <div class="flex flex-wrap gap-2">
        {stack.map((s) => <span class="pill">{s}</span>)}
      </div>
    </div>

    <span
      class="hidden shrink-0 text-ink-500 transition group-hover:translate-x-1 group-hover:text-accent md:block"
      aria-hidden="true"
    >
      →
    </span>
  </div>
</a>
