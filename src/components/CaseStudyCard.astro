---
interface Props {
  slug: string;
  title: string;
  outcome: string;
  summary: string;
  stack: string[];
  company?: string;
  year?: string;
  index: number;
}

const { slug, title, outcome, summary, stack, company, year, index } =
  Astro.props;
const idx = String(index).padStart(2, "0");
---

<a
  href={`/case-studies/${slug}`}
  class="group block rounded-xl border border-ink-800 bg-ink-900/40 p-8 transition hover:border-ink-600 hover:bg-ink-900"
>
  <div class="flex items-start justify-between gap-6">
    <div class="space-y-5">
      <div class="flex items-center gap-4">
        <span class="font-mono text-xs text-ink-500">{idx}</span>
        {
          (company || year) && (
            <span class="font-mono text-xs text-ink-400">
              {[company, year].filter(Boolean).join(" · ")}
            </span>
          )
        }
      </div>

      <h3
        class="text-2xl text-ink-50 transition-colors group-hover:text-accent md:text-3xl"
      >
        {title}
      </h3>

      <p class="text-ink-300">
        <span class="text-ink-200">{outcome}</span> — {summary}
      </p>

      <div class="flex flex-wrap gap-2">
        {stack.map((s) => <span class="pill">{s}</span>)}
      </div>
    </div>

    <span
      class="hidden shrink-0 text-ink-500 transition group-hover:translate-x-1 group-hover:text-accent md:block"
      aria-hidden="true"
    >
      →
    </span>
  </div>
</a>
