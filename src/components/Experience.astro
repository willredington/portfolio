---
interface Role {
  company: string;
  title: string;
  period: string;
  bullets: string[];
}

const roles: Role[] = [
  {
    company: "Livefront",
    title: "Technical Architect",
    period: "2025 — Present",
    bullets: [
      "Architected an AI-powered oncology patient triage system using Azure Bot Framework and OpenAI, enabling physicians to evaluate patient symptoms through a conversational interface.",
      "Built internal and client-facing DevOps tooling that unified Jira, GitHub, and CI systems into a single workflow platform.",
      "Lead architect for medical pricing operations services, owning a significant portion of the system and leveraging Claude Code and Cursor as primary agentic coding tools.",
      "Developed and taught an internal course on AI SDKs and tooling, upskilling the engineering team on practical LLM integration.",
    ],
  },
  {
    company: "Freya Systems",
    title: "Technical Architect",
    period: "2023 — 2024",
    bullets: [
      "Led architecture and system design for aircraft maintenance and supply chain applications across AWS, Azure, and OpenShift.",
      "Built DevOps pipelines using Jenkins, Spring Batch, Hadoop, and Spark; designed and implemented custom ETLs across distributed data sources.",
      "Designed APIs and backend services in Spring; delivered frontends in React and Angular.",
      "Mentored a team of 5 developers through biweekly knowledge transfers focused on DevOps and cloud engineering.",
    ],
  },
  {
    company: "ComplyAuto",
    title: "Senior Software Engineer (Contract)",
    period: "2022 — 2023",
    bullets: [
      "Independently built environmental compliance features across a Fastify / GraphQL / React stack.",
    ],
  },
  {
    company: "98point6",
    title: "Software Engineer II",
    period: "2021 — 2022",
    bullets: [
      "Designed and implemented a serverless electronic prescription system using AWS CDK, Lambda, Step Functions, SQS, and DynamoDB — migrating physicians from manual call-in workflows to a fully digital FHIR-compliant system.",
      "Structured complex clinical workflows as composable Lambda and Step Functions pipelines, with a heavy focus on serverless architecture patterns.",
    ],
  },
  {
    company: "Freya Systems",
    title: "Senior Software Engineer",
    period: "2019 — 2021",
    bullets: [
      "Developed aircraft fleet management software in Java and Spring; collaborated with data scientists to integrate analytical models into production systems.",
    ],
  },
  {
    company: "The Boeing Company",
    title: "Software Engineer",
    period: "2016 — 2019",
    bullets: [
      "Built analytics and reporting tools for military aircraft mechanical health monitoring; developed ETL pipelines using Java, Python, Spring Batch, Hadoop, and Spark.",
    ],
  },
];
---

<section id="experience" class="border-b border-ink-900 py-24">
  <div class="container-wide">
    <div class="grid gap-12 md:grid-cols-[1fr_1.5fr]">
      <div>
        <p class="eyebrow">Experience</p>
        <h2 class="mt-4 text-3xl md:text-4xl">Career timeline</h2>
      </div>

      <ol class="relative space-y-10">
        {
          roles.map((role) => (
            <li class="border-l border-ink-800 pl-8 md:pl-10">
              <div class="absolute -left-[5px] mt-2 h-2.5 w-2.5 rounded-full bg-accent/60" />
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-xl text-ink-50">
                  {role.title}
                  <span class="text-ink-400"> · </span>
                  <span class="font-serif text-ink-200">{role.company}</span>
                </h3>
                <span class="font-mono text-xs text-ink-400">
                  {role.period}
                </span>
              </div>
              <ul class="mt-3 space-y-2 text-ink-300">
                {role.bullets.map((b) => (
                  <li class="flex gap-3 text-[0.95rem] leading-relaxed">
                    <span class="mt-2 inline-block h-px w-3 shrink-0 bg-ink-600" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
