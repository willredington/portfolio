---
interface SkillGroup {
  label: string;
  items: string[];
}

const groups: SkillGroup[] = [
  {
    label: "AI / LLM",
    items: [
      "Claude Code",
      "Cursor",
      "Pi",
      "Azure Bot Framework",
      "LangChain",
      "Vercel",
      "Langfuse",
      "Agentic pipelines",
      "Vector stores",
    ],
  },
  {
    label: "Cloud & DevOps",
    items: [
      "Azure",
      "AWS",
      "Terraform",
      "AWS CDK",
      "Kubernetes",
      "OpenShift",
      "DevOps",
    ],
  },
  {
    label: "Languages & Frameworks",
    items: [
      "TypeScript",
      "Node.js",
      "Python",
      "Java",
      "Golang",
      "Next.js",
      "React",
      "Angular",
      "Fastify",
      "Spring",
      "FastAPI",
    ],
  },
];
---

<section id="skills" class="border-b border-ink-900 py-24">
  <div class="container-wide grid gap-16 md:grid-cols-[1fr_1.5fr]">
    <div>
      <p class="eyebrow">Skills</p>
      <h2 class="mt-4 text-3xl md:text-4xl">Tools & technologies</h2>
    </div>

    <div class="space-y-8">
      {
        groups.map((g) => (
          <div>
            <h3 class="font-serif text-lg text-ink-50">{g.label}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {g.items.map((s) => (
                <span class="pill">{s}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
